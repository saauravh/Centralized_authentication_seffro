# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=central_auth

# JWT
JWT_ISSUER=seffro-identity
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Emailed single-use tokens (seconds)
RESET_TOKEN_TTL=3600
VERIFY_TOKEN_TTL=86400

# SMTP. Leave SMTP_HOST empty to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@seffro.com

# Pages in the consumer apps that emailed links point at. The service appends
# ?token=...&email=... to these.
PASSWORD_RESET_URL=http://localhost:8000/central/password/reset
EMAIL_VERIFY_URL=http://localhost:8000/central/email/verify

# Shared secret every Laravel app sends as X-Service-Secret. REQUIRED in
# production — the service refuses to boot without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_SECRET=

# CORS
CORS_ORIGIN=

