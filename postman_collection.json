                "value": "{{service_secret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_url}}/api/auth/verify-email",
              "host": [
                "{{identity_url}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-email"
              ]
            },
            "description": "Redeems the verification token from EMAIL_VERIFY_URL. Single-use and expiring.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"token\": \"<token from the emailed link>\"\n}"
            }
          }
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Service-Secret",
                "value": "{{service_secret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_url}}/api/auth/resend-verification",
              "host": [
                "{{identity_url}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-verification"
              ]
            },
            "description": "Silent for unknown or already-verified addresses, same anti-enumeration rule as forgot-password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            }
          }
        }
      ]
