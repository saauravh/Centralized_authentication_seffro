    {
      "name": "🌐 Web SSO Login (Cross-Platform)",
      "description": "Test the web-based SSO login flow.\nRegister on one platform, log in via the other platform's web form.",
      "item": [
        {
          "name": "Test Flow: Register on Seffro API → Login on Hellpu Web",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "{{email}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{helppu_url}}/auth/login",
              "host": ["{{helppu_url}}"],
              "path": ["auth", "login"]
            },
            "description": "⚠️  PREREQUISITE: First register via Seffro API 'Register (user)' above.\n\nThen run this: it simulates logging into the Hellpu admin web form\nwith the same email+password.\n\nIf the user was registered on Seffro as 'user', this will fail\n(no auto-create for admin dashboard — expected).\n\nFor a positive test, register on Hellpu as provider/handyman first."
          }
        },
        {
          "name": "Test Flow: Register on Hellpu API → Login on Seffro Web (User)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{email}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{seffro_url}}/user/login-submit",
              "host": ["{{seffro_url}}"],
              "path": ["user", "login-submit"]
            },
            "description": "⚠️  PREREQUISITE: First register via Hellpu API 'Register (user)' above.\n\nThen run this: it simulates logging into the Seffro user web form\nwith the same email+password.\n\nSeffro will auto-create a local User record if none exists."
          }
        },
        {
          "name": "Test Flow: Register on Seffro API → Login on Seffro Web (Vendor)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "vendor_{{email}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{seffro_url}}/vendor/login/submit",
              "host": ["{{seffro_url}}"],
              "path": ["vendor", "login", "submit"]
            },
            "description": "⚠️  PREREQUISITE: First register via Seffro API 'Register (vendor)' above.\n\nThen run this: it simulates logging into the Seffro vendor web form.\nSeffro will auto-create a local Vendor record if none exists."
          }
        }
      ]
    },
    {
      "name": "🧪 Suggested Test Scenarios",
      "description": "Step-by-step test flows to verify SSO is working end-to-end.",
      "item": [
        {
          "name": "Scenario A: Register on Seffro → Login on Hellpu API",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://google.com",
              "host": ["https://google.com"]
            },
            "description": "1. Set collection variables:\n   email = test_a@example.com\n   password = Test@1234\n\n2. Run: Seffro → 'Register (user)'\n   → Should return 201 with tokens\n\n3. Run: Hellpu → 'Login' (with same email+password)\n   → Should return 200 with tokens\n   → user_type should be 'user'\n   → Hellpu auto-created local profile\n\n✅ PASS: Single identity works across both platforms"
          }
        },
        {
          "name": "Scenario B: Register on Hellpu → Login on Seffro Web",
