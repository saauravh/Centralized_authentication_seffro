        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Service-Secret",
                "value": "{{service_secret}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_url}}/api/auth/logout",
              "host": [
                "{{identity_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the refresh token, and blacklists the access token if the Authorization header is present. Without the header the access token stays usable until it expires — send it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Service-Secret",
                "value": "{{service_secret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_url}}/api/auth/forgot-password",
              "host": [
                "{{identity_url}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Emails a single-use link to PASSWORD_RESET_URL.\n\nAlways returns { success: true } — identical for unknown addresses, so this cannot be used to enumerate accounts. With SMTP_HOST unset the link is printed to the service log.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Service-Secret",
                "value": "{{service_secret}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_url}}/api/auth/reset-password",
              "host": [
                "{{identity_url}}"
              ],
              "path": [
                "api",
                "auth",
                "reset-password"
              ]
            },
            "description": "Redeems the reset token. Single-use, expiring, and validated before it is spent so a malformed request cannot burn the link.\n\nOn success every refresh token is revoked and a tokens_valid_from cutoff is set, on the assumption that a reset may be a response to compromise.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"token\": \"<token from the emailed link>\",\n  \"new_password\": \"BrandNewPass789\"\n}"
            }
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
