{
  "info": {
    "name": "Central Auth SSO — Full API Collection",
    "description": "Complete API collection for the Central Auth SSO system.\n\nCovers:\n- Identity Server (internal, dev only)\n- Hellpu Central Auth (/api/central/*)\n- Seffro Central Auth (/api/central/*)\n- Web SSO login flows (cross-platform)\n\n📌 Set variables at the collection level before testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "helppu_url",
      "value": "http://admin.helppu.com",
      "type": "string"
    },
    {
      "key": "seffro_url",
      "value": "https://in.seffro.com",
      "type": "string"
    },
    {
      "key": "email",
      "value": "sso_test@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Test@1234",
      "type": "string"
    },
    {
      "key": "first_name",
      "value": "John",
      "type": "string"
    },
    {
      "key": "last_name",
      "value": "Doe",
      "type": "string"
    },
    {
      "key": "phone",
      "value": "+1234567890",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "central_user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Identity Server (internal)",
      "description": "These call the central Node.js identity server directly.\nUse for dev/testing only — mobile apps NEVER call these directly.",
      "item": [
        {
          "name": "Register on Identity Server",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('central_user_id', json.user.id.toString());",
                  "    pm.collectionVariables.set('access_token', json.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"first_name\": \"{{first_name}}\",\n  \"last_name\": \"{{last_name}}\",\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/auth/register",
              "host": ["{{auth_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new central identity. Phone can be omitted if not available."
          }
        },
        {
          "name": "Login on Identity Server",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('central_user_id', json.user.id.toString());",
                  "    pm.collectionVariables.set('access_token', json.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/auth/login",
              "host": ["{{auth_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/auth/refresh",
              "host": ["{{auth_url}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Verify Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access_token\": \"{{access_token}}\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/auth/verify",
              "host": ["{{auth_url}}"],
              "path": ["api", "auth", "verify"]
            }
          }
        },
        {
          "name": "Get Profile (Identity Server)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{auth_url}}/api/auth/me",
              "host": ["{{auth_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/auth/logout",
              "host": ["{{auth_url}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{auth_url}}/api/health",
              "host": ["{{auth_url}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
