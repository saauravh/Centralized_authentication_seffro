        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Service-Secret",
                "value": "{{service_secret}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{identity_url}}/api/auth/profile",
              "host": [
                "{{identity_url}}"
              ],
              "path": [
                "api",
                "auth",
                "profile"
              ]
            },
            "description": "Updates the identity fields this service owns. All fields optional; at least one required.\nAccepts: first_name, last_name, phone, email, avatar.\n\nChanging the email resets email_verified_at and sends a new verification mail, so nobody moves to an address they do not control and keeps a verified badge.\nstatus and password are NOT writable here — password has its own endpoint.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jonathan\",\n  \"phone\": \"5559999999\"\n}"
            }
          }
        },
